{
  "name": "@bunbu/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm pronunciations && rolldown -c",
    "dev": "rolldown -c --watch",
    "typecheck": "tsc --noEmit && tsc -p scripts",
    "test": "vitest run test/",
    "bench": "vitest run bench/",
    "pronunciations": "tsx scripts/compile-pronunciations.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "fflate": "^0.8.3",
    "rolldown": "^1.2.12",
    "rolldown-plugin-dts": "^0.28.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zstdify": "^1.4.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "lzma-web": "^4.0.0",
    "yaml": "^2.9.1"
  }
}
